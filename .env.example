PORT=8000
NODE_ENV=development
PERSISTENCE_TYPE=memory
NOTIFIER_TYPE=console
LOW_STOCK_THRESHOLD=2

# --- Seguridad (Clase 11) ---
# Generá un secreto largo y aleatorio: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
LOGIN_RATE_LIMIT_MAX=5
ADMIN_EMAIL=admin@biblioteca.com
ADMIN_PASSWORD=Admin1234

# --- Consumo de APIs externas (Clase 12) ---
# "openlibrary" consulta la API real; "fake" usa datos locales con demora simulada (sirve sin internet)
CATALOG_TYPE=openlibrary
OPEN_LIBRARY_URL=https://openlibrary.org
EXTERNAL_TIMEOUT_MS=5000
IMPORT_CONCURRENCY=3
# Caché del catálogo real en ms (0 = apagada; ej. 600000 = 10 min) y reintentos ante fallas transitorias (0 = sin reintentos).
# La caché está apagada por defecto: si estuviera activa, /catalog/lookup mostraría la 2ª consulta ya cacheada y la
# comparación de tiempos entre modos dejaría de ser honesta. Se enciende en el ejercicio 9.
CATALOG_CACHE_TTL_MS=0
EXTERNAL_RETRIES=0
EXTERNAL_RETRY_BASE_MS=1000
FAKE_LATENCY_MS=300

# --- Reglas de negocio de préstamos (Clase 13) ---
LOAN_MAX_ACTIVE=3
LOAN_BUSINESS_DAYS=10
LOAN_MAX_RENEWALS=1
# "argentinadatos" (API real), "fake" (feriados locales, sin red) o "fake-down" (simula la API caída)
HOLIDAYS_TYPE=argentinadatos
HOLIDAYS_URL=https://api.argentinadatos.com
# Reloj fijo para "viajar en el tiempo" (ej. 2026-12-01T12:00:00Z). Dejalo vacío para usar la hora real.
CLOCK_NOW=
