{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "description": "API REST de Biblioteca — Documentación con OpenAPI/Swagger, README y buenas prácticas (Clase 15)",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env index.js",
    "dev": "node --env-file=.env --watch index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs:export": "node scripts/exportOpenApi.js"
  },
  "keywords": [
    "express",
    "rest-api",
    "node",
    "zod",
    "dao",
    "sequelize",
    "sqlite",
    "ioc",
    "jwt",
    "bcrypt",
    "auth",
    "fetch",
    "csv",
    "open-library",
    "vitest",
    "testing",
    "openapi",
    "swagger"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
